#:culture{:id "yem.dish.saltah", :name "Saltah", :country "YEM", :kind :dish, :summary "National dish of Yemen: a brown meat-broth stew (maraq) topped with fenugreek foam (hulbah) and sahawiq (a chili-tomato-herb sauce), widely eaten in the north for lunch and scooped up with khubz mulawah flatbread.", :url "https://en.wikipedia.org/wiki/Saltah", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "yem.dish.mandi", :name "Mandi", :country "YEM", :kind :dish, :summary "Meat-and-rice dish cooked in an underground pit with a special spice blend; Yemen is its region of origin, traditionally served on large communal platters with a tangy tomato sauce, and it spread through Yemeni migration to Hyderabadi cuisine.", :url "https://en.wikipedia.org/wiki/Mandi_(food)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "yem.dish.bint-al-sahn", :name "Bint al-sahn", :country "YEM", :kind :dish, :summary "Traditional Yemeni pastry (also known as sabayah) of white flour, eggs, yeast and clarified butter (samn) baked in paper-thin layers and topped with honey and black cumin seeds; rarely found in restaurants and usually made at home.", :url "https://en.wikipedia.org/wiki/Bint_al-sahn", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "yem.product.mokha-coffee", :name "Mokha coffee", :country "YEM", :kind :product, :summary "Coffee beans from Ethiopia and inland Yemen were shipped abroad through the Yemeni port of Mokha from the 16th through 19th centuries, giving the world the term 'mocha coffee'; Mokha beans remain prized for their distinctive flavor today.", :url "https://en.wikipedia.org/wiki/Mokha", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "yem.craft.jambiya", :name "Jambiya", :country "YEM", :kind :craft, :summary "Short ceremonial dagger worn by men in Yemen, originating from the Hadhramaut region; the handle material is a traditional measure of the dagger's value and its owner's social status.", :url "https://en.wikipedia.org/wiki/Jambiya", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "yem.heritage.old-city-of-sanaa", :name "Old City of Sana'a", :country "YEM", :kind :heritage, :summary "UNESCO World Heritage Site (designated 1986) in Yemen's Amanat Al Asimah Governorate, a mountain-valley city inhabited for more than 2,500 years known for its many-storeyed tower-houses built of rammed earth.", :url "https://en.wikipedia.org/wiki/Old_City_of_Sanaa", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "yem.heritage.shibam", :name "Shibam", :country "YEM", :kind :heritage, :summary "Town in eastern Yemen's Hadhramaut region renowned for its distinctive mudbrick high-rise architecture, designated a UNESCO World Heritage Site in 1982.", :url "https://en.wikipedia.org/wiki/Shibam", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
]
